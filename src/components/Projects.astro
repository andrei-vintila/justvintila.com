---
import SectionHeading from "./SectionHeading.astro";
import { projects, profile } from "../data/content";

type Live = { stars: number; pushedAt: string; language: string | null };

const liveData = new Map<string, Live>();

await Promise.all(
  projects.map(async (p) => {
    try {
      const res = await fetch(`https://api.github.com/repos/${profile.githubUser}/${p.repo}`, {
        headers: {
          Accept: "application/vnd.github+json",
          "User-Agent": "justvintila.com-build",
        },
      });
      if (!res.ok) return;
      const json = (await res.json()) as any;
      liveData.set(p.repo, {
        stars: json.stargazers_count ?? 0,
        pushedAt: json.pushed_at ?? "",
        language: json.language ?? null,
      });
    } catch {
      // build-time fetch failed (offline); fall back to static copy below
    }
  })
);

const fmtDate = (iso: string) => {
  if (!iso) return "";
  return new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric" }).format(new Date(iso));
};
---

<section id="builds" class="builds reveal">
  <SectionHeading index="03" title="builds" />
  <p class="builds__lede">
    Side projects, unfiltered. No product spec, no roadmap, just something I wanted to exist.
  </p>

  <div class="builds__grid">
    {
      projects.map((p) => {
        const live = liveData.get(p.repo);
        return (
          <a class="pcard" href={p.url} target="_blank" rel="noreferrer">
            <div class="pcard__top mono">
              <span class="pcard__dot" aria-hidden="true" />
              <span class="pcard__name">{p.name}</span>
              {live && (
                <span class="pcard__stars dim">
                  ★ {live.stars} <span class="dim">· {fmtDate(live.pushedAt)}</span>
                </span>
              )}
            </div>
            <p class="pcard__desc">{p.description}</p>
            {p.highlight && <p class="pcard__highlight mono">// {p.highlight}</p>}
            <div class="pcard__stack mono">
              {p.stack.map((s) => (
                <span class="pcard__tag">{s}</span>
              ))}
            </div>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .builds {
    padding: 64px 0;
    border-bottom: 1px solid var(--border);
  }
  .builds__lede {
    margin: -8px 0 32px;
    color: var(--fg-dim);
    font-size: 14px;
    max-width: 55ch;
  }
  .builds__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .pcard {
    display: block;
    text-decoration: none;
    color: var(--fg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    padding: 20px;
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }
  .pcard:hover {
    border-color: var(--accent-dim);
    background: #171a15;
    transform: translateY(-2px);
  }
  .pcard__top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    margin-bottom: 12px;
  }
  .pcard__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
  }
  .pcard__name {
    color: var(--fg);
    font-weight: 500;
  }
  .pcard__stars {
    margin-left: auto;
    font-size: 11px;
    white-space: nowrap;
  }
  .pcard__desc {
    margin: 0 0 12px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .pcard__highlight {
    margin: 0 0 14px;
    font-size: 11.5px;
    color: var(--accent);
    line-height: 1.5;
  }
  .pcard__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pcard__tag {
    font-size: 10.5px;
    padding: 3px 7px;
    border: 1px solid var(--border-bright);
    color: var(--fg-dim);
  }
</style>
