<script>
  import posthog from "posthog-js";

  const key = import.meta.env.PUBLIC_POSTHOG_KEY;
  const host = import.meta.env.PUBLIC_POSTHOG_HOST;

  if (key && host) {
    posthog.init(key, {
      api_host: host,
      person_profiles: "identified_only",
      defaults: "2025-05-24",
      loaded(ph) {
        // dev/preview traffic still gets tracked (by request) — tag it so
        // it's filterable/excludable from real visitor data in PostHog
        ph.register({ app_env: import.meta.env.MODE });
      },
    });
  }
</script>
