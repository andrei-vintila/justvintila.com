{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "justvintila-com",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// requires justvintila.com's zone to already be on this Cloudflare account
	// (Websites > justvintila.com). Remove this block if it isn't yet, and
	// add the custom domain from the Workers dashboard after the first deploy instead.
	"routes": [
		{ "pattern": "justvintila.com", "custom_domain": true },
		{ "pattern": "www.justvintila.com", "custom_domain": true }
	]
}